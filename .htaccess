<IfModule mod_rewrite.c>
    RewriteEngine On

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # The public disk is the only storage path intended to be web-accessible.
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # Laravel's web root lives in /public, while shared hosting serves this folder.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(?:\..*|.*\.(?:sql|log|bak))$">
    Require all denied
</FilesMatch>
